# mipsorcu Compose runtime example.
# Copy this file to ".env", then replace placeholders with deployment values.
# Do not commit ".env" or any file containing service_role keys, Master Keys,
# ledger signing keys, JWTs, Data Keys, passphrases, plaintext, request bodies,
# or response bodies.
#
# audit-ui に渡してはいけない env:
# - MIPSORCU_SUPABASE_SERVICE_ROLE_KEY
# - MIPSORCU_MASTER_KEY
# - MIPSORCU_LEDGER_SIGNING_KEY
# - MIPSORCU_ALIAS_ENCRYPTION_KEY
# - MIPSORCU_ALIAS_FINGERPRINT_KEY

# === Container listen address ===
# Risk: Low. compose.yaml also sets this explicitly for the mipsorcu service.
MIPSORCU_LISTEN_ADDR="0.0.0.0:3000"

# === Supabase connection ===
# Risk: Low. External Supabase project URL. Supabase itself is not part of compose.yaml.
MIPSORCU_SUPABASE_URL="https://your-project-ref.supabase.co"
# Risk: Critical. Server container only. Never pass to audit-ui, browser code, logs, tickets, or reports.
MIPSORCU_SUPABASE_SERVICE_ROLE_KEY="<replace_with_service_role_key>"
# Risk: Low. Publishable client key; still avoid unnecessary log exposure.
MIPSORCU_SUPABASE_PUBLISHABLE_KEY="<replace_with_publishable_or_anon_key>"

# === Master Key configuration ===
# Risk: Critical. Server container only. Use a 32-byte Master Key encoded as 64 lowercase hex chars.
MIPSORCU_MASTER_KEY="<replace_with_64_hex_chars>"
# Risk: Low. Active version for the single-key mode above.
MIPSORCU_KEY_VERSION="1"

# Optional keyring mode for rotation. Store 32-byte Master Keys as 64-hex-char
# files named "1.key", "2.key", ... under the persisted volume. If enabled,
# unset MIPSORCU_MASTER_KEY and MIPSORCU_KEY_VERSION.
# Risk: Critical. Directory contains Master Keys.
# MIPSORCU_MASTER_KEY_DIR="/var/lib/mipsorcu/master-keys"
# Risk: Low.
# MIPSORCU_ACTIVE_KEY_VERSION="1"

# === Alias keys ===
# Risk: Critical. Server container only. Use a 32-byte key encoded as 64 lowercase hex chars.
MIPSORCU_ALIAS_ENCRYPTION_KEY="<replace_with_64_hex_chars>"
# Risk: Low.
MIPSORCU_ALIAS_ENCRYPTION_KEY_VERSION="1"
# Risk: High. Server container only. HMAC key for alias fingerprinting.
MIPSORCU_ALIAS_FINGERPRINT_KEY="<replace_with_64_hex_chars>"
# Risk: Low.
MIPSORCU_ALIAS_FINGERPRINT_KEY_VERSION="1"

# === Ledger signing ===
# Risk: Critical. Server container only. Ledger Ed25519 signing secret.
MIPSORCU_LEDGER_SIGNING_KEY="<replace_with_64_hex_chars>"
# Risk: Low.
MIPSORCU_LEDGER_SIGNATURE_KEY_VERSION="1"

# === Supabase Auth / JWT verification ===
# Risk: Low. Public issuer string.
MIPSORCU_JWT_ISSUER="https://your-project-ref.supabase.co/auth/v1"
# Risk: Low.
MIPSORCU_JWT_AUDIENCE="authenticated"
# Risk: Low. JWKS endpoint URL.
MIPSORCU_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# === Persistent container paths ===
# Risk: Low. Keep these under "/var/lib/mipsorcu" so the "mipsorcu-data" Docker
# volume preserves audit fallback, SIEM buffer, and scheduler archive files.
MIPSORCU_AUDIT_FALLBACK_PATH="/var/lib/mipsorcu/audit-fallback-current.jsonl"
MIPSORCU_SIEM_BUFFER_PATH="/var/lib/mipsorcu/siem-buffer-current.jsonl"
MIPSORCU_AUDIT_FALLBACK_ARCHIVE_DIR="/var/lib/mipsorcu/archive"
MIPSORCU_SCHEDULER_LOCAL_ARCHIVE_DIR="/var/lib/mipsorcu/scheduler-archive"

# === Optional operational intervals and thresholds ===
# Risk: Low. Tune only when the operational impact is understood.
MIPSORCU_AUDIT_RESEND_INTERVAL_SECONDS="60"
MIPSORCU_SIEM_RESEND_INTERVAL_SECONDS="60"
MIPSORCU_SIEM_LONG_FAILURE_THRESHOLD_SECONDS="900"
MIPSORCU_AUDIT_FALLBACK_ALERT_THRESHOLD_BYTES="10485760"
MIPSORCU_AUDIT_FALLBACK_ROTATE_SIZE_BYTES="67108864"
MIPSORCU_AUDIT_FALLBACK_ARCHIVE_AUTO_DELETE_ENABLED="false"
MIPSORCU_AUDIT_FALLBACK_ARCHIVE_RETENTION_DAYS="90"
MIPSORCU_RESTORE_TEST_INTERVAL_SECONDS="86400"
MIPSORCU_RESTORE_TEST_STARTUP_DELAY_SECONDS="300"
MIPSORCU_RESTORE_TEST_SAMPLE_LIMIT="3"
MIPSORCU_INTEGRITY_CHECK_INTERVAL_SECONDS="86400"
MIPSORCU_INTEGRITY_CHECK_STARTUP_DELAY_SECONDS="3900"
MIPSORCU_JWKS_REFRESH_INTERVAL_SECONDS="3600"
MIPSORCU_HEALTH_READINESS_POLL_INTERVAL_SECONDS="30"
MIPSORCU_OUTBOUND_HTTP_CONNECT_TIMEOUT_SECONDS="5"
MIPSORCU_OUTBOUND_HTTP_REQUEST_TIMEOUT_SECONDS="20"
MIPSORCU_HTTP_HANDLER_TIMEOUT_SECONDS="75"
MIPSORCU_HTTP_RATE_LIMIT_REQUESTS="300"
MIPSORCU_HTTP_RATE_LIMIT_WINDOW_SECONDS="60"

# === Scheduler control ===
# Risk: Low. Scheduler is single replica only in v0.1.0.
MIPSORCU_SCHEDULER_ENABLED="false"
MIPSORCU_SCHEDULER_STARTUP_DELAY_SECONDS="4500"
MIPSORCU_SCHEDULER_POLL_INTERVAL_SECONDS="3600"
MIPSORCU_SCHEDULER_MONTHLY_DAY="1"
MIPSORCU_SCHEDULER_MONTHLY_HOUR_UTC="3"
MIPSORCU_SCHEDULER_QUARTERLY_HOUR_UTC="4"
# Risk: Low. v0.2.0 daily envelope lazy migration (Task 07/12).
MIPSORCU_SCHEDULER_DAILY_HOUR_UTC="4"
MIPSORCU_SCHEDULER_ENVELOPE_MIGRATION_BATCH_SIZE="100"
MIPSORCU_SCHEDULER_ENVELOPE_MIGRATION_MAX_BATCHES="10"

# === SIEM exporter (v0.2.0, Task 13) ===
# Risk: Low. exporter selector; none disables outbound and only writes to local buffer.
MIPSORCU_SIEM_EXPORTER="none"  # none | otlp | splunk_hec
# Risk: Low. Required when MIPSORCU_SIEM_EXPORTER=otlp. Full URL to OTLP/HTTP/JSON /v1/logs endpoint.
# MIPSORCU_SIEM_OTLP_ENDPOINT="https://collector.example/v1/logs"
# Risk: Critical. Optional bearer token for OTLP collector. Server container only.
# MIPSORCU_SIEM_OTLP_AUTH_TOKEN="<replace_with_otlp_bearer_token>"
# Risk: Low. Required when MIPSORCU_SIEM_EXPORTER=splunk_hec. Splunk HEC event endpoint.
# MIPSORCU_SIEM_SPLUNK_HEC_URL="https://splunk.example:8088/services/collector/event"
# Risk: Critical. Splunk HEC token. Server container only.
# MIPSORCU_SIEM_SPLUNK_HEC_TOKEN="<replace_with_splunk_hec_token>"

# === Incident notification (v0.2.0, Task 14) ===
# Risk: Low. notifier selector; none and dummy are functionally identical (no outbound).
MIPSORCU_INCIDENT_NOTIFIER="none"  # none | dummy | webhook
# Risk: Low. Required when MIPSORCU_INCIDENT_NOTIFIER=webhook.
# MIPSORCU_INCIDENT_WEBHOOK_URL="https://webhook.example/incident"
# Risk: Critical. HMAC-SHA3-256 shared secret. At least 32 bytes. Server container only.
# MIPSORCU_INCIDENT_WEBHOOK_SECRET="<replace_with_64_hex_chars>"

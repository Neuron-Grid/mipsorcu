# mipsorcu Rust server container runtime example.
# Copy this file to ".env.container", then replace placeholders with local test values.
# Do not commit ".env.container" or any file containing service_role keys,
# Master Keys, alias keys, ledger signing keys, JWTs, Data Keys, plaintext,
# request bodies, or response bodies.

# Container listen address. Bare metal default remains 127.0.0.1:3000.
MIPSORCU_LISTEN_ADDR=0.0.0.0:3000

# Supabase connection. Critical: server container only. Never pass the
# service_role key to audit-ui, browser code, logs, tickets, or reports.
MIPSORCU_SUPABASE_URL=https://your-project-ref.supabase.co
MIPSORCU_SUPABASE_SERVICE_ROLE_KEY=<replace_with_service_role_key>
MIPSORCU_SUPABASE_PUBLISHABLE_KEY=<replace_with_publishable_or_anon_key>

# Master Key configuration. Use a 32-byte key encoded as 64 lowercase hex chars.
# Critical: keep inside the SBC/server trust boundary and never bake into image.
MIPSORCU_MASTER_KEY=<replace_with_64_hex_chars>
MIPSORCU_KEY_VERSION=1

# Alias encryption and fingerprint keys. Use 32-byte keys encoded as 64 hex chars.
MIPSORCU_ALIAS_ENCRYPTION_KEY=<replace_with_64_hex_chars>
MIPSORCU_ALIAS_ENCRYPTION_KEY_VERSION=1
MIPSORCU_ALIAS_FINGERPRINT_KEY=<replace_with_64_hex_chars>
MIPSORCU_ALIAS_FINGERPRINT_KEY_VERSION=1

# Ledger signing. Critical: signing secret stays inside the SBC/server boundary.
MIPSORCU_LEDGER_SIGNING_KEY=<replace_with_64_hex_chars>
MIPSORCU_LEDGER_SIGNATURE_KEY_VERSION=1

# Supabase Auth / JWT verification.
MIPSORCU_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
MIPSORCU_JWT_AUDIENCE=authenticated
MIPSORCU_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Persistent container paths. Mount /var/lib/mipsorcu as a volume.
MIPSORCU_AUDIT_FALLBACK_PATH=/var/lib/mipsorcu/audit-fallback-current.jsonl
MIPSORCU_SIEM_BUFFER_PATH=/var/lib/mipsorcu/siem-buffer-current.jsonl
MIPSORCU_AUDIT_FALLBACK_ARCHIVE_DIR=/var/lib/mipsorcu/archive
MIPSORCU_SCHEDULER_LOCAL_ARCHIVE_DIR=/var/lib/mipsorcu/scheduler-archive

# Scheduler is single-replica only. Keep disabled for Task 02-2 runtime checks.
MIPSORCU_SCHEDULER_ENABLED=false

# Incident notification (Task 14). webhook is the v0.2.0 production acceptance
# path. none and dummy do not send outbound notifications. Email env vars are
# not used in v0.2.0.
MIPSORCU_INCIDENT_NOTIFIER=none  # none | dummy | webhook
# Required only when MIPSORCU_INCIDENT_NOTIFIER=webhook. Production must use https; local tests may use localhost http.
# MIPSORCU_INCIDENT_WEBHOOK_URL=https://webhook.example/incident
# Critical: HMAC-SHA3-256 shared secret, at least 32 bytes. Server container only.
# MIPSORCU_INCIDENT_WEBHOOK_SECRET=<replace_with_64_hex_chars>
# Per-attempt webhook request timeout, 1-30 seconds.
MIPSORCU_INCIDENT_WEBHOOK_REQUEST_TIMEOUT_SECONDS=5

# External archive (Task 10 / ADR-0032, ADR-0033). Used by `mipsorcu archive`.
# Required for the archive CLI; no silent default. object key is digests/{YYYY-MM}/digest.json.
MIPSORCU_ARCHIVE_BACKEND=local_dummy
MIPSORCU_ARCHIVE_LOCAL_DIR=/var/lib/mipsorcu/archive
# S3 Object Lock backend (required only when MIPSORCU_ARCHIVE_BACKEND=s3_object_lock).
# Critical: S3 credentials stay in the server container; independent of service_role.
# MIPSORCU_ARCHIVE_S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# MIPSORCU_ARCHIVE_S3_REGION=us-east-1
# MIPSORCU_ARCHIVE_S3_BUCKET=mipsorcu-archive-prod
# MIPSORCU_ARCHIVE_S3_ACCESS_KEY_ID=<replace_with_s3_access_key_id>
# MIPSORCU_ARCHIVE_S3_SECRET_ACCESS_KEY=<replace_with_s3_secret_access_key>
# MIPSORCU_ARCHIVE_S3_OBJECT_LOCK_MODE=compliance
# MIPSORCU_ARCHIVE_S3_RETENTION_DAYS=2555

# External timestamping (Task 11 / ADR-0040). Used by `mipsorcu timestamping`.
# Required for the timestamping CLI; no silent default. The TSA response is stored
# via MIPSORCU_ARCHIVE_BACKEND at object key timestamping/{YYYY-MM}/token.tsr.
MIPSORCU_TIMESTAMPING_PROVIDER=local_dummy  # local_dummy | rfc3161
# RFC 3161 TSA (required only when MIPSORCU_TIMESTAMPING_PROVIDER=rfc3161).
# Comma-separated endpoints (sequential fallback); HTTPS only, TLS never bypassed.
# SHA3-256 imprint (ADR-0040) — confirm TSA support (see known-limitations-v0.2.0.md).
# MIPSORCU_TSA_URL=https://tsa.example.com/tsr
# Critical: optional TSA Basic-auth; password stays in the server container, never logged.
# MIPSORCU_TSA_USERNAME=<replace_with_tsa_username>
# MIPSORCU_TSA_PASSWORD=<replace_with_tsa_password>
